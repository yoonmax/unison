# ---------------------------------------------------------------------------
# Server (required)
# ---------------------------------------------------------------------------
# Postgres connection used by the Next.js server. Never exposed to browsers.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) for Vercel/serverless.
# Local:    `npm run dev:local` starts an embedded Postgres and sets this for you.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: connection used only by `npm run db:migrate` (Supabase "Session pooler" or direct, port 5432).
# Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Salt for hashing client IPs in rate-limit buckets. Any long random string.
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Optional tuning
# DATABASE_POOL_MAX=5
# RATE_LIMIT_SCALE=1

# ---------------------------------------------------------------------------
# Realtime (required for serverless hosting such as Vercel)
# ---------------------------------------------------------------------------
# With these set, browsers receive "room changed" pings via Supabase Realtime
# Broadcast (sent from the database on commit). Without them, the app falls back
# to Server-Sent Events from its own server, which only works on a single
# long-running Node process (local dev, a VM, Fly/Render with one instance).
# Supabase: Project Settings → API → Project URL / Publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# For testing on a phone over plain http on your LAN (not for production):
# UNISON_INSECURE_COOKIES=1
